rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function slotOneIs(uid) {
      return exists(/databases/$(database)/documents/slots/one)
        && get(/databases/$(database)/documents/slots/one).data.uid == uid;
    }

    function slotTwoIs(uid) {
      return exists(/databases/$(database)/documents/slots/two)
        && get(/databases/$(database)/documents/slots/two).data.uid == uid;
    }

    function isMember() {
      return signedIn() && (slotOneIs(request.auth.uid) || slotTwoIs(request.auth.uid));
    }

    // Solo existen dos documentos válidos: slots/one y slots/two.
    // Pueden leerlos cuentas autenticadas para saber si queda un cupo.
    // No contienen mensajes ni perfiles, únicamente UID y fecha.
    match /slots/{slotId} {
      allow read: if signedIn();

      allow create: if signedIn()
        && !isMember()
        && (slotId == "one" || slotId == "two")
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(["uid", "createdAt"]);

      // Permite deshacer un registro que falló antes de crear el perfil.
      allow delete: if signedIn()
        && resource.data.uid == request.auth.uid
        && !exists(/databases/$(database)/documents/profiles/$(request.auth.uid));

      allow update: if false;
    }

    // Alias exacto de usuario. Se permite GET sin login para poder convertir
    // @usuario -> identificador interno de Firebase Auth. No se permite listar.
    match /aliases/{handle} {
      allow get: if true;
      allow list: if false;

      allow create: if isMember()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.email == request.auth.token.email;

      allow delete: if isMember()
        && resource.data.uid == request.auth.uid;

      allow update: if false;
    }

    match /profiles/{uid} {
      allow read: if isMember();

      allow create: if isMember()
        && uid == request.auth.uid
        && request.resource.data.uid == request.auth.uid;

      allow update: if isMember()
        && uid == request.auth.uid
        && resource.data.uid == request.auth.uid
        && request.resource.data.uid == request.auth.uid;

      allow delete: if false;
    }

    match /messages/{messageId} {
      allow read: if isMember();

      allow create: if isMember()
        && request.resource.data.senderId == request.auth.uid;

      allow update: if isMember()
        && resource.data.senderId == request.auth.uid
        && request.resource.data.senderId == request.auth.uid;

      allow delete: if isMember()
        && resource.data.senderId == request.auth.uid;
    }

    match /presence/{uid} {
      allow read: if isMember();
      allow create, update: if isMember()
        && uid == request.auth.uid
        && request.resource.data.uid == request.auth.uid;
      allow delete: if false;
    }

    match /typing/{uid} {
      allow read: if isMember();
      allow create, update: if isMember()
        && uid == request.auth.uid
        && request.resource.data.uid == request.auth.uid;
      allow delete: if false;
    }

    match /nudges/{nudgeId} {
      allow read: if isMember();
      allow create: if isMember()
        && request.resource.data.senderId == request.auth.uid
        && request.resource.data.targetId != request.auth.uid;
      allow update, delete: if false;
    }

    // Datos pequeños que comparten ambos: leído, fijado, fecha y juegos.
    match /shared/{docId} {
      allow read, create, update: if isMember();
      allow delete: if false;
    }

    match /games/{gameId} {
      allow read, create, update: if isMember();
      allow delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
